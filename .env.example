# Copy these names into Replit Secrets or a local .env file. Do not commit real values.
DATABASE_URL=

# Admin
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Public app URL
APP_BASE_URL=https://register.swpsummit.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=SWP Summit

# Organiser notifications
ORGANISER_EMAIL=

# Optional Google Sheets sync
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional DB pool tuning
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
