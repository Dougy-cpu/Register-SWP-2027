# Copy these names into Replit Secrets or a local .env file. Do not commit real values.
DATABASE_URL=

# Admin
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Sponsor private links and sessions (use a separate random value, 32+ characters)
SPONSOR_TOKEN_SECRET=

# Public app URL
APP_BASE_URL=https://register.swpsummit.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=SWP Summit

# Organiser notifications
ORGANISER_EMAIL=

# Sponsor App Storage
# Replit App Storage is the production adapter; use memory only for automated/local tests.
SPONSOR_STORAGE_ADAPTER=
# Set a unique prefix in preview/test environments, e.g. preview/sponsor-workspace-20260901
SPONSOR_STORAGE_PREFIX=

# Required only at the moment an approved production sponsor migration is run.
PRODUCTION_BACKUP_REFERENCE=

# Optional Google Sheets sync
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional DB pool tuning
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
